# ============================================
# Convex Configuration
# ============================================
# URL de tu proyecto Convex (obtenida de https://dashboard.convex.dev)
VITE_CONVEX_URL=https://tu-proyecto.convex.cloud

# ID de tu deployment de Convex
CONVEX_DEPLOYMENT=tu-deployment-id

# ============================================
# OpenAI Configuration
# ============================================
# Tu API key de OpenAI para embeddings y encuestas
OPENAI_API_KEY=sk-...

# ============================================
# Supabase Configuration
# ============================================
# URL de tu proyecto Supabase (obtenida de https://supabase.com/dashboard)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key de Supabase (para acceso completo desde el backend)
# Obtén esto en: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon Key de Supabase (para acceso público desde el frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# GNews API Configuration
# ============================================
# API key de GNews para obtener noticias
# Obtén una en: https://gnews.io/
GNEWS_API_KEY=...
