# ==================== CONVEX ====================
# URL de tu proyecto Convex (obtenida desde el dashboard de Convex)
VITE_CONVEX_URL=https://tu-proyecto.convex.cloud

# Deployment de Convex (formato: dev:nombre-deployment o prod:nombre-deployment)
# Para producción usa: CONVEX_DEPLOYMENT=prod:tu-deployment
CONVEX_DEPLOYMENT=dev:tu-deployment

# ==================== OPENAI ====================
# API Key de OpenAI para ejecutar encuestas con IA
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-api-key-aqui

# ==================== OPCIONAL ====================
# Si necesitas configurar variables adicionales para tu servidor
# PORT=5173
# NODE_ENV=production
